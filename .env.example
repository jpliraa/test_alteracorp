# Copia este archivo a .env (ignorado por git) y completa los valores.
# Las Lambdas leen estas vars vía process.env; el IaC las inyecta por stage.

# Secret HMAC compartido con PayHub (no commitear el real)
PAYHUB_HMAC_SECRET=dev-secret-change-me

# Stage actual (dev | staging | prod)
STAGE=dev

# Nombres de recursos (sobrescritos por el IaC en deploy real)
IDEMPOTENCY_TABLE=prueba-altera-b2-idempotency-dev
PAGOS_TABLE=prueba-altera-b2-pagos-dev
WEBHOOK_QUEUE_URL=http://localhost:9324/queue/webhook-queue-dev
WEBHOOK_DLQ_URL=http://localhost:9324/queue/webhook-dlq-dev

# Endpoints locales (ElasticMQ + DynamoDB Local)
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
SQS_ENDPOINT=http://localhost:9324

# Powertools
POWERTOOLS_SERVICE_NAME=prueba-altera-b2
POWERTOOLS_METRICS_NAMESPACE=PruebaAlteraB2
LOG_LEVEL=INFO
