# =============================================================================
# .env.example — plantilla de variables de entorno
#
# Cómo usar:
#   1. Copia este archivo a `.env` (en la raíz del repo).
#   2. Los valores default funcionan tal cual para correr todo en local con
#      Docker (DDB Local + ElasticMQ).
#   3. `.env` está en `.gitignore` — nunca se commitea.
#
# En Bash / Git Bash:    cp .env.example .env
# En PowerShell:         Copy-Item .env.example .env
# =============================================================================

# Secret HMAC compartido con PayHub.
# En prod: viene de AWS Secrets Manager, NO de .env literal.
PAYHUB_HMAC_SECRET=dev-secret-change-me

# Stage actual (dev | staging | prod)
STAGE=dev
AWS_REGION=us-east-1

# Tablas DDB — los nombres deben matchear los del IaC y los del bootstrap-local.sh
IDEMPOTENCY_TABLE=prueba-altera-b2-idempotency-dev
PAGOS_TABLE=prueba-altera-b2-pagos-dev

# URLs de las colas SQS.
# IMPORTANTE: ElasticMQ usa el formato AWS-compatible /{account-id}/{queue-name}.
# El account-id local es siempre 000000000000.
WEBHOOK_QUEUE_URL=http://localhost:9324/000000000000/prueba-altera-b2-webhook-queue-dev
WEBHOOK_DLQ_URL=http://localhost:9324/000000000000/prueba-altera-b2-webhook-dlq-dev

# Endpoints locales para el SDK AWS (override del default que apunta a AWS real).
# En prod NO se setean → SDK usa AWS.
DYNAMODB_ENDPOINT=http://localhost:8000
SQS_ENDPOINT=http://localhost:9324

# Credenciales AWS fake.
# DDB Local y ElasticMQ aceptan cualquier valor, pero el SDK exige que existan
# para inicializar el cliente.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Powertools (logger / metrics)
POWERTOOLS_SERVICE_NAME=prueba-altera-b2
POWERTOOLS_METRICS_NAMESPACE=PruebaAlteraB2
POWERTOOLS_LOG_LEVEL=INFO
LOG_LEVEL=INFO

# Bandera para que el código sepa que está corriendo offline.
# `serverless offline` la setea automáticamente; la incluimos acá para
# `serverless invoke local` y para scripts standalone.
IS_OFFLINE=true

# Probabilidad de fallo transient simulado en el Processor (rúbrica Tarea 5).
# - 0.05 (default) = 5% como pide el enunciado.
# - 0    = sin fallo (útil para e2e determinista).
# - 1    = siempre falla (útil para probar el path de error).
TRANSIENT_FAILURE_RATE=0
