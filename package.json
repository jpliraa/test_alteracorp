{
  "name": "prueba-altera-b2",
  "version": "0.1.0",
  "private": true,
  "description": "Webhook serverless de pagos PayHub con idempotencia y DLQ — prueba técnica Altera ALT-B2-0526-C04",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "offline": "serverless offline start --stage dev",
    "bootstrap:local": "bash scripts/bootstrap-local.sh",
    "invoke:receiver:valid": "serverless invoke local -f receiver --path Template_B2_Serverless/sample-events/valid-webhook.json --stage dev",
    "invoke:receiver:invalid": "serverless invoke local -f receiver --path Template_B2_Serverless/sample-events/invalid-signature.json --stage dev",
    "invoke:receiver:duplicate": "serverless invoke local -f receiver --path Template_B2_Serverless/sample-events/duplicate-event.json --stage dev",
    "invoke:processor:batch": "serverless invoke local -f processor --path Template_B2_Serverless/sample-events/batch-partial-failure.json --stage dev",
    "e2e": "bash scripts/e2e-test.sh"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.10.0",
    "@aws-lambda-powertools/metrics": "^2.10.0",
    "@aws-lambda-powertools/tracer": "^2.10.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.55.1",
    "serverless-offline": "^13.9.0",
    "serverless-offline-sqs": "^8.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
